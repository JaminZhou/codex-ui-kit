{
  "name": "codex-ui-kit",
  "version": "0.1.0",
  "private": true,
  "description": "Independently designed React components for Codex-style coding-agent interfaces.",
  "keywords": [
    "agent-ui",
    "codex",
    "react",
    "typescript"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/JaminZhou/codex-ui-kit.git"
  },
  "homepage": "https://jaminzhou.com/codex-ui-kit/",
  "bugs": {
    "url": "https://github.com/JaminZhou/codex-ui-kit/issues"
  },
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "files": [
    "dist"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./styles.css": {
      "types": "./dist/styles.d.ts",
      "default": "./dist/style.css"
    },
    "./tokens.css": {
      "types": "./dist/tokens.d.ts",
      "default": "./dist/tokens.css"
    }
  },
  "scripts": {
    "dev": "vite demo --config demo/vite.config.ts",
    "dev:electron": "pnpm build && pnpm --filter @codex-ui-kit/electron-playground dev",
    "dev:codex-app": "pnpm build && pnpm --filter @codex-ui-kit/codex-app-playground dev",
    "dev:codex-app:electron": "pnpm build && pnpm --filter @codex-ui-kit/codex-app-playground dev:electron",
    "build": "vite build && tsc -p tsconfig.build.json",
    "build:demo": "vite build demo --base=/codex-ui-kit/ --config demo/vite.config.ts && node scripts/check-demo-bundle.mjs",
    "build:electron": "pnpm --filter @codex-ui-kit/electron-playground build",
    "build:codex-app": "pnpm build && pnpm --filter @codex-ui-kit/codex-app-playground build",
    "check:a11y": "node scripts/check-accessibility.mjs",
    "check:visual:scenarios": "pnpm build:demo && node scripts/check-visual-scenarios.mjs",
    "check:visual:current-thread": "pnpm build:demo && node scripts/check-current-thread-visual.mjs",
    "check:browser:streaming": "pnpm build:demo && node scripts/check-current-streaming-browser.mjs",
    "check:browser:command": "pnpm build:demo && node scripts/check-current-command-browser.mjs",
    "check:visual:streaming": "pnpm build:demo && node scripts/check-visual-scenarios.mjs --scenes=current-thread-streaming,current-thread-streaming-compact",
    "check:visual:command": "pnpm build:demo && node scripts/check-current-command-visual.mjs",
    "check:visual:workflow": "pnpm build:demo && node scripts/check-visual-scenarios.mjs --scenes=current-thread-tool-call,current-thread-approval,current-workspace-file-diff",
    "check:visual:tool-recovery": "pnpm build:demo && node scripts/check-visual-scenarios.mjs --scenes=current-compact-search-tool,current-compact-browser-tool,current-compact-mcp-unavailable,current-compact-command-failure",
    "check:visual:continuity": "pnpm build:demo && node scripts/check-visual-scenarios.mjs --scenes=current-medium-message-navigation,current-compact-scroll-away,current-compact-interrupted,current-compact-context-running,current-compact-context-completed",
    "check:research": "node scripts/check-research-inventory.mjs && node scripts/check-visual-assets.mjs && node scripts/update-current-thread-visual-assets.mjs",
    "capture:current-baseline": "node scripts/capture-current-baseline.mjs",
    "update:visual-assets": "node scripts/update-current-visual-assets.mjs --write",
    "update:current-thread-visual-assets": "node scripts/update-current-thread-visual-assets.mjs --write",
    "check:codex-app": "pnpm build && pnpm --filter @codex-ui-kit/codex-app-playground check",
    "check:codex-app:acceptance": "pnpm build && pnpm --filter @codex-ui-kit/codex-app-playground check:acceptance",
    "prepack": "node scripts/prepack.mjs",
    "test": "vitest run tests",
    "typecheck": "tsc --noEmit",
    "check:package": "node scripts/check-package.mjs && tsc -p fixtures/package-consumer/tsconfig.json && tsc -p fixtures/package-consumer/tsconfig.nodenext.json && publint && attw --pack . --ignore-rules cjs-resolves-to-esm no-resolution",
    "check": "pnpm check:research && pnpm typecheck && pnpm test && pnpm build && pnpm check:package && pnpm build:demo && node scripts/check-current-streaming-browser.mjs && node scripts/check-current-command-browser.mjs && pnpm check:a11y && pnpm --filter @codex-ui-kit/electron-playground check && pnpm --filter @codex-ui-kit/codex-app-playground check"
  },
  "publishConfig": {
    "access": "public"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18"
  },
  "packageManager": "pnpm@11.7.0",
  "devDependencies": {
    "@arethetypeswrong/cli": "0.18.5",
    "@testing-library/react": "^16.3.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "axe-core": "4.12.1",
    "happy-dom": "^20.11.1",
    "pixelmatch": "7.2.0",
    "pngjs": "7.0.0",
    "publint": "0.3.22",
    "puppeteer-core": "25.5.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "typescript": "^7.0.2",
    "vite": "^8.1.5",
    "vitest": "^4.1.10"
  },
  "dependencies": {
    "highlight.js": "11.11.1",
    "react-markdown": "10.1.0",
    "remark-gfm": "4.0.1"
  }
}
