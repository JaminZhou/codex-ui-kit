{
  "name": "codex-ui-kit",
  "version": "0.1.0",
  "description": "Independently designed React components for Codex-style coding-agent interfaces.",
  "keywords": [
    "agent-ui",
    "codex",
    "react",
    "typescript"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/JaminZhou/codex-ui-kit.git"
  },
  "homepage": "https://jaminzhou.com/codex-ui-kit/",
  "bugs": {
    "url": "https://github.com/JaminZhou/codex-ui-kit/issues"
  },
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "files": [
    "dist",
    "THIRD_PARTY_NOTICES.md"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./styles.css": {
      "types": "./dist/styles.d.ts",
      "default": "./dist/style.css"
    },
    "./tokens.css": {
      "types": "./dist/tokens.d.ts",
      "default": "./dist/tokens.css"
    }
  },
  "scripts": {
    "dev": "vite demo --config demo/vite.config.ts",
    "dev:electron": "pnpm build && pnpm --filter @codex-ui-kit/electron-playground dev",
    "dev:codex-app": "pnpm build && pnpm --filter @codex-ui-kit/codex-app-playground dev",
    "dev:codex-app:electron": "pnpm build && pnpm --filter @codex-ui-kit/codex-app-playground dev:electron",
    "build": "vite build && tsc -p tsconfig.build.json",
    "build:demo": "vite build demo --base=/codex-ui-kit/ --config demo/vite.config.ts && node scripts/check-demo-bundle.mjs",
    "build:electron": "pnpm --filter @codex-ui-kit/electron-playground build",
    "build:codex-app": "pnpm build && pnpm --filter @codex-ui-kit/codex-app-playground build",
    "check:a11y": "node scripts/check-accessibility.mjs",
    "check:visual:scenarios": "pnpm build:demo && node scripts/check-visual-scenarios.mjs",
    "check:visual:current-thread": "pnpm build:demo && node scripts/check-current-thread-visual.mjs",
    "check:browser:streaming": "pnpm build:demo && node scripts/check-current-streaming-browser.mjs",
    "check:browser:command": "pnpm build:demo && node scripts/check-current-command-browser.mjs",
    "check:visual:streaming": "pnpm build:demo && node scripts/check-visual-scenarios.mjs --scenes=current-thread-streaming,current-thread-streaming-compact",
    "check:visual:command": "pnpm build:demo && node scripts/check-current-command-visual.mjs",
    "check:visual:workflow": "pnpm build:demo && node scripts/check-visual-scenarios.mjs --scenes=current-thread-tool-call,current-thread-approval,current-workspace-file-diff",
    "check:visual:tool-recovery": "pnpm build:demo && node scripts/check-visual-scenarios.mjs --scenes=current-compact-search-tool,current-compact-browser-tool,current-compact-mcp-unavailable,current-compact-command-failure",
    "check:visual:continuity": "pnpm build:demo && node scripts/check-visual-scenarios.mjs --scenes=current-medium-message-navigation,current-compact-scroll-away,current-compact-interrupted,current-compact-context-running,current-compact-context-completed",
    "check:visual:review": "pnpm build:demo && node scripts/check-visual-scenarios.mjs --scenes=current-review-file-card,current-review-file-card-compact,current-review-workspace,current-review-workspace-compact",
    "check:research": "node scripts/check-research-inventory.mjs && node scripts/check-current-pdf-preview.mjs && node scripts/check-visual-assets.mjs && node scripts/check-current-account-menu-assets-26-917-71314.mjs && node scripts/update-current-thread-visual-assets.mjs",
    "capture:current-baseline": "node scripts/capture-current-baseline.mjs",
    "capture:current-baseline-26-917": "CODEX_CURRENT_BASELINE_FINGERPRINT=26.917.71314 node scripts/capture-current-baseline.mjs",
    "capture:current-settings-connections-26-917-62051": "CODEX_CURRENT_SETTINGS_CONNECTIONS_FINGERPRINT=26.917.62051 node scripts/capture-current-settings-connections.mjs",
    "capture:current-settings-connections-26-917-71314": "CODEX_CURRENT_SETTINGS_CONNECTIONS_FINGERPRINT=26.917.71314 node scripts/capture-current-settings-connections.mjs",
    "capture:current-account-menu": "node scripts/capture-current-account-menu.mjs",
    "capture:current-account-menu-26-917-71314": "CODEX_CURRENT_ACCOUNT_MENU_FINGERPRINT=26.917.71314 node scripts/capture-current-account-menu.mjs",
    "capture:current-account-menu-icons-26-917-71314": "CODEX_CURRENT_ACCOUNT_MENU_FINGERPRINT=26.917.71314 CODEX_CURRENT_ACCOUNT_MENU_OBSERVATION_ONLY=1 CODEX_CURRENT_ACCOUNT_MENU_INCLUDE_ICON_PATHS=1 CODEX_CURRENT_ACCOUNT_MENU_ALLOW_PREFERENCES=1 node scripts/capture-current-account-menu.mjs",
    "check:account-menu-assets-26-917-71314": "node scripts/check-current-account-menu-assets-26-917-71314.mjs",
    "capture:current-long-thread": "node scripts/capture-current-long-thread.mjs",
    "capture:current-mcp": "node scripts/capture-current-mcp.mjs",
    "capture:current-mcp-26-915": "CODEX_CURRENT_MCP_FINGERPRINT=26.915.31945 node scripts/capture-current-mcp.mjs",
    "capture:current-mcp-26-917-71314": "CODEX_CURRENT_MCP_FINGERPRINT=26.917.71314 node scripts/capture-current-mcp.mjs",
    "capture:current-composer-menu-26-917-71314": "node scripts/capture-current-composer-menu.mjs",
    "capture:current-command": "node scripts/capture-current-command.mjs",
    "capture:current-command-26-825": "node scripts/capture-current-command-anchor.mjs",
    "capture:current-browser-success-26-825": "node scripts/capture-current-browser-success.mjs",
    "capture:current-attachment-26-825": "node scripts/capture-current-attachment.mjs",
    "capture:current-integrations-26-825": "node scripts/capture-current-integrations.mjs",
    "capture:current-integrations-26-915": "CODEX_CURRENT_INTEGRATIONS_FINGERPRINT=26.915.31945 node scripts/capture-current-integrations.mjs",
    "capture:current-sites-26-915": "node scripts/capture-current-sites.mjs",
    "capture:current-plugin-detail-26-825": "node scripts/capture-current-plugin-detail.mjs",
    "capture:current-plugin-detail-26-915": "CODEX_CURRENT_PLUGIN_DETAIL_FINGERPRINT=26.915.31945 node scripts/capture-current-plugin-detail.mjs",
    "capture:current-skill-detail-26-825": "node scripts/capture-current-skill-detail.mjs",
    "capture:current-skill-detail-26-915": "CODEX_CURRENT_SKILL_DETAIL_FINGERPRINT=26.915.31945 node scripts/capture-current-skill-detail.mjs",
    "capture:current-thread-overflow-26-825": "node scripts/capture-current-thread-overflow.mjs",
    "capture:current-thread-overflow-26-915": "CODEX_CURRENT_THREAD_OVERFLOW_FINGERPRINT=26.915.31945 node scripts/capture-current-thread-overflow.mjs",
    "capture:current-mcp-settings-26-825": "node scripts/capture-current-mcp-settings.mjs",
    "capture:current-mcp-settings-26-915": "CODEX_CURRENT_MCP_SETTINGS_FINGERPRINT=26.915.31945 node scripts/capture-current-mcp-settings.mjs",
    "capture:current-automations-26-903": "node scripts/capture-current-automations.mjs",
    "capture:current-compaction-26-825": "node scripts/capture-current-compaction.mjs",
    "capture:current-transport-proxy-26-825": "node scripts/current-transport-proxy.mjs",
    "capture:current-review-26-825": "node scripts/capture-current-review-anchor.mjs",
    "capture:current-approval": "node scripts/capture-current-approval.mjs",
    "capture:current-sidebar-rows": "node scripts/capture-current-sidebar-rows.mjs",
    "capture:current-notifications": "node scripts/capture-current-notifications.mjs",
    "capture:current-notifications-26-915": "CODEX_CURRENT_NOTIFICATIONS_FINGERPRINT=26.915.31945 node scripts/capture-current-notifications.mjs",
    "capture:current-app-server-crash": "node scripts/capture-current-app-server-crash.mjs",
    "update:visual-assets": "node scripts/update-current-visual-assets.mjs --write",
    "update:visual-assets:review": "node scripts/update-current-visual-assets.mjs --review-only --write",
    "update:current-thread-visual-assets": "node scripts/update-current-thread-visual-assets.mjs --write",
    "check:codex-app": "pnpm build && pnpm --filter @codex-ui-kit/codex-app-playground check",
    "check:codex-app:acceptance": "pnpm build && pnpm --filter @codex-ui-kit/codex-app-playground check:acceptance:full && pnpm --filter @codex-ui-kit/codex-app-playground check:current-sidebar-account-26-917 && pnpm --filter @codex-ui-kit/codex-app-playground check:composer-resources-current-26-917-71314",
    "prepack": "node scripts/prepack.mjs",
    "test": "vitest run tests",
    "typecheck": "tsc --noEmit",
    "check:package": "node scripts/check-package.mjs && node scripts/check-release-candidate.mjs && tsc -p fixtures/package-consumer/tsconfig.json && tsc -p fixtures/package-consumer/tsconfig.nodenext.json && publint && attw --pack . --ignore-rules cjs-resolves-to-esm no-resolution",
    "check:release:candidate": "node scripts/check-release-candidate.mjs",
    "check": "pnpm check:research && pnpm typecheck && pnpm test && pnpm build && pnpm check:package && pnpm build:demo && node scripts/check-current-streaming-browser.mjs && node scripts/check-current-command-browser.mjs && pnpm check:a11y && pnpm --filter @codex-ui-kit/electron-playground check && pnpm --filter @codex-ui-kit/codex-app-playground check"
  },
  "publishConfig": {
    "access": "public",
    "tag": "latest",
    "registry": "https://registry.npmjs.org/"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18"
  },
  "packageManager": "pnpm@11.7.0",
  "devDependencies": {
    "@arethetypeswrong/cli": "0.18.5",
    "@testing-library/react": "^16.3.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.2.5",
    "axe-core": "4.13.0",
    "happy-dom": "^20.14.5",
    "pixelmatch": "7.2.0",
    "pngjs": "7.0.0",
    "publint": "0.3.24",
    "puppeteer-core": "25.11.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "typescript": "^7.0.2",
    "vite": "^8.2.1",
    "vitest": "^5.0.1"
  },
  "dependencies": {
    "highlight.js": "11.12.0",
    "katex": "0.18.7",
    "react-markdown": "10.1.0",
    "rehype-katex": "7.0.1",
    "remark-gfm": "4.0.1",
    "remark-math": "6.0.0"
  }
}
