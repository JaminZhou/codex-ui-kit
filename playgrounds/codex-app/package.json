{
  "name": "@codex-ui-kit/codex-app-playground",
  "version": "0.0.0",
  "private": true,
  "description": "Protocol-backed Codex app integration playground for codex-ui-kit.",
  "license": "MIT",
  "type": "module",
  "main": "dist-electron/main.js",
  "scripts": {
    "build:renderer": "vite build",
    "build:electron": "tsc -p electron/tsconfig.json && cp electron/preload.cjs dist-electron/preload.cjs",
    "build": "pnpm build:renderer && pnpm build:electron",
    "dev": "vite",
    "dev:electron": "pnpm build && electron .",
    "start": "electron .",
    "typecheck": "tsc --noEmit && tsc -p electron/tsconfig.json --noEmit",
    "test": "vitest run tests",
    "check:protocol": "node scripts/check-protocol-traces.mjs",
    "check:cdp": "node scripts/check-cdp-contract.mjs",
    "check:electron": "node scripts/check-electron-contract.mjs",
    "check:visual": "node scripts/check-visual-contract.mjs",
    "visual:update": "node scripts/check-visual-contract.mjs --update",
    "check": "pnpm check:protocol && pnpm typecheck && pnpm test && pnpm build",
    "check:acceptance": "pnpm build && pnpm check:cdp && pnpm check:electron && pnpm check:visual",
    "check:all": "pnpm check && pnpm check:cdp && pnpm check:electron && pnpm check:visual"
  },
  "dependencies": {
    "@jaminzhou/codex-app-server-client": "github:JaminZhou/codex-app-server-client#97ffcd496aa0aefdbdc868d13a5bce4e09a5afc5",
    "codex-ui-kit": "workspace:*",
    "react": "19.2.7",
    "react-dom": "19.2.7"
  },
  "devDependencies": {
    "ajv": "8.20.0",
    "@types/node": "26.1.1",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.1",
    "electron": "43.2.0",
    "pixelmatch": "7.2.0",
    "playwright-core": "1.55.0",
    "pngjs": "7.0.0",
    "typescript": "5.9.3",
    "vite": "8.1.5",
    "vitest": "4.1.10"
  },
  "engines": {
    "node": ">=22"
  }
}
