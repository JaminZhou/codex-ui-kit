{
  "name": "@codex-ui-kit/codex-app-playground",
  "version": "0.0.0",
  "private": true,
  "description": "Protocol-backed Codex app integration playground for codex-ui-kit.",
  "license": "MIT",
  "type": "module",
  "main": "dist-electron/main.js",
  "scripts": {
    "build:renderer": "vite build",
    "build:electron": "tsc -p electron/tsconfig.json && cp electron/preload.cjs dist-electron/preload.cjs",
    "build": "pnpm build:renderer && pnpm build:electron",
    "dev": "vite",
    "dev:electron": "pnpm build && electron .",
    "start": "electron .",
    "typecheck": "tsc --noEmit && tsc -p electron/tsconfig.json --noEmit",
    "test": "vitest run tests",
    "check:protocol": "node scripts/check-protocol-traces.mjs",
    "check:cdp": "node scripts/check-cdp-contract.mjs",
    "check:electron": "node scripts/check-electron-contract.mjs",
    "check:live-policy": "node scripts/check-live-policy.mjs",
    "check:live-file-content": "node scripts/check-live-file-content.mjs",
    "check:live-terminal": "node scripts/check-live-pty.mjs && node scripts/check-live-pty-ui.mjs",
    "check:live-approval": "node scripts/check-live-approval.mjs",
    "check:live-projects": "node scripts/check-live-projects.mjs",
    "check:live-stop": "node scripts/check-live-stop.mjs",
    "check:user-input": "node scripts/check-user-input-contract.mjs",
    "check:live-input": "node scripts/check-live-user-input.mjs",
    "check:live-history": "node scripts/check-live-history.mjs",
    "check:history": "node scripts/check-history-contract.mjs",
    "check:project-discovery": "node scripts/check-project-discovery.mjs",
    "check:branch-recovery": "node scripts/check-branch-recovery.mjs",
    "check:commit-preview": "node scripts/check-commit-preview.mjs",
    "check:push-preview": "node scripts/check-push-preview.mjs",
    "check:pr-preview": "node scripts/check-pr-preview.mjs",
    "check:pr-cleanup": "node scripts/check-pr-cleanup.mjs",
    "check:live-pr-route": "node scripts/check-live-pr-route.mjs",
    "check:visual": "node scripts/check-visual-contract.mjs",
    "visual:update": "node scripts/check-visual-contract.mjs --update",
    "check": "pnpm check:protocol && pnpm typecheck && pnpm test && pnpm build",
    "check:acceptance": "pnpm build && pnpm check:live-policy && pnpm check:live-file-content && pnpm check:user-input && pnpm check:history && pnpm check:project-discovery && pnpm check:branch-recovery && pnpm check:commit-preview && pnpm check:push-preview && pnpm check:pr-preview && pnpm check:pr-cleanup && pnpm check:live-pr-route && pnpm check:cdp && pnpm check:electron && pnpm check:visual",
    "check:all": "pnpm check && pnpm check:live-policy && pnpm check:live-file-content && pnpm check:cdp && pnpm check:electron && pnpm check:visual"
  },
  "dependencies": {
    "@xterm/xterm": "6.0.0",
    "@xterm/addon-fit": "0.11.0",
    "@jaminzhou/codex-app-server-client": "github:JaminZhou/codex-app-server-client#8cf5823ee12c00f7bc9c5eaeef80049e65f0e881",
    "codex-ui-kit": "workspace:*",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "ajv": "8.20.0",
    "@types/node": "24.13.3",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "@vitejs/plugin-react": "6.1.1",
    "electron": "43.2.0",
    "pixelmatch": "7.2.0",
    "playwright-core": "1.62.1",
    "pngjs": "7.0.0",
    "typescript": "5.9.3",
    "vite": "8.2.1",
    "vitest": "5.0.0"
  },
  "engines": {
    "node": ">=22"
  }
}
